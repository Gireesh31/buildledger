{
  "expo": {
    "name": "BuildLedger",
    "slug": "buildledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildledger.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EA580C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.buildledger.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "buildledger",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-community/datetimepicker"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BuildLedger uses your photos to attach bills.",
          "cameraPermission": "BuildLedger uses the camera to photograph bills."
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ec843f22-22e2-40c1-b734-5638a549bb72"
      }
    },
    "owner": "gireeshtp"
  }
}
